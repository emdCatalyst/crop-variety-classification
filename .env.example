APP_NAME=Agro-Vision
DEBUG=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_TTL_MINUTES=10080

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local dev (file-based)
DATABASE_URL=sqlite:///./agrovision.db

# Hugging Face Spaces (durable, libSQL)
# DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?secure=true
# TURSO_AUTH_TOKEN=...

MAX_UPLOAD_MB=200
NUM_TIMESTEPS=12

# External AI agronomy advisor (Phase 1.5).
# Provider: heuristic | gemini | groq
# - heuristic: in-repo NDVI/NDRE thresholds; no network, no key, deterministic.
# - gemini:    Google Gemini 2.5 Flash. Free tier ≈15 RPM / 1500 RPD. Key at https://aistudio.google.com/app/apikey
# - groq:      Llama 3.3 70B via Groq. Free tier ≈30 RPM. Key at https://console.groq.com/keys
# Any LLM failure (timeout, malformed JSON, missing key) automatically falls back to heuristic.
HEALTH_AI_PROVIDER=heuristic
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
HEALTH_AI_TIMEOUT_S=8

# Dev only: artificial pause (seconds) inserted after each inference stage
# emit so the progress UI is observable on a fast machine. 0 disables.
DEV_STAGE_DELAY_S=3

# Pretty (human-readable) logs by default. Flip to false in production for
# JSON-serialized lines suitable for log shippers.
LOG_PRETTY=true

# Email (signup verification + password reset).
# When SMTP_USER and SMTP_PASSWORD are unset, the server logs the code to
# stdout instead of sending — handy for local dev and demo without external
# accounts. To send real email via Gmail: enable 2FA on your Google account,
# create an App Password (https://myaccount.google.com/apppasswords) and
# paste it as SMTP_PASSWORD below.
# if we want gmail  its gonna be smtp.gmail.com as host and 587 as port
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
EMAIL_CODE_TTL_MINUTES=15
