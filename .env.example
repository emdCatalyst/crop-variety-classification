APP_NAME=Agro-Vision
DEBUG=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_TTL_MINUTES=10080

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local dev (file-based)
DATABASE_URL=sqlite:///./agrovision.db

# Hugging Face Spaces (durable, libSQL)
# DATABASE_URL=sqlite+libsql://<db>-<org>.turso.io/?secure=true
# TURSO_AUTH_TOKEN=...

MAX_UPLOAD_MB=200
NUM_TIMESTEPS=12
