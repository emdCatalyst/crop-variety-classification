APP_NAME=Agro-Vision
DEBUG=false

# REQUIRED: replace with a fresh long random secret.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32
JWT_ALG=HS256
JWT_TTL_MINUTES=10080

# REQUIRED behind HTTPS. Set to false only if you are running over plain HTTP
# on a private/LAN network (auth cookies will not be sent over HTTPS otherwise).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# SQLite file inside the mounted ./data volume (persists across container
# restarts). Switch to a libSQL/Turso URL if you want a managed remote DB.
DATABASE_URL=sqlite:////app/data/agrovision.db

MAX_UPLOAD_MB=200
NUM_TIMESTEPS=12

# AI agronomy advisor. `heuristic` works offline and needs no key. To use a
# hosted LLM, set the provider and paste the matching API key.
HEALTH_AI_PROVIDER=heuristic
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
HEALTH_AI_TIMEOUT_S=8

# Production: keep at 0 (the dev-only artificial pause is for demoing the
# progress UI on a fast machine).
DEV_STAGE_DELAY_S=0

# Production: emit JSON log lines for log shippers. Flip to true if you want
# pretty human-readable lines (e.g. when tailing logs locally).
LOG_PRETTY=false

# Email (signup verification + password reset). Leave empty to log codes to
# stdout instead of sending — handy for first-run smoke tests. To send real
# email, plug in any SMTP provider (Brevo, SendGrid, Gmail+App-Password, …).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Agro-Vision
EMAIL_CODE_TTL_MINUTES=15
